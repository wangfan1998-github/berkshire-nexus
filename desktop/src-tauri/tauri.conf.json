{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BerkshireNexus",
  "version": "1.3.0",
  "identifier": "com.berkshire.nexus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BerkshireNexus",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 720,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Auditable US-equity research and paper trading",
    "longDescription": "BerkshireNexus combines research, adaptive learning, deterministic risk controls, and audited paper execution in a desktop operations console.",
    "resources": {
      "../../src": "python/src"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
